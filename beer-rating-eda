      "source": [
        "**Features included**:\n",
        "\n",
        "\n",
        "1. index: Identifier for the review.\n",
        "\n",
        "2. beer/ABV: Alcohol by volume of the beer.\n",
        "\n",
        "3. beer/beerId: Unique ID for the beer reviewed.\n",
        "\n",
        "4. beer/brewerId: Unique ID for the brewery.\n",
        "\n",
        "5. beer/name: Name of the beer.\n",
        "\n",
        "6. beer/style: Style/type of the beer.\n",
        "\n",
        "7. review/appearance: Rating of the beer’s appearance (1.0 to 5.0).\n",
        "\n",
        "8. review/aroma: Rating of the beer’s aroma (1.0 to 5.0).\n",
        "\n",
        "9. review/overall: Overall rating of the beer (1.0 to 5.0).\n",
        "\n",
        "10. review/palate: Rating of the beer’s palate (1.0 to 5.0).\n",
        "\n",
        "11. review/taste: Rating of the beer’s taste (1.0 to 5.0).\n",
        "\n",
        "12. review/text: Text of the review.\n",
        "\n",
        "13. review/timeStruct: Structured timestamp for when the review was submitted.\n",
        "\n",
        "14. review/timeUnix: Unix timestamp of the review.\n",
        "\n",
        "15. user/ageInSeconds: Age of the user in seconds.\n",
        "\n",
        "16. user/birthdayRaw: User’s raw birthday information.\n",
        "\n",
        "17. user/birthdayUnix: Unix timestamp for the user’s birthday.\n",
        "\n",
        "18. user/gender: Gender of the user (if specified).\n",
        "\n",
        "19. user/profileName: Profile name of the user."
