      "cell_type": "code",
      "source": [
        "beer_train_only_win_lose_filtered = beer_train_only_win_lose[['beer/name', 'avg_review', 'status']]\n",
        "\n",
        "# Группировка по статусу, средние значения и стандартное отклонение\n",
        "summary_stats = beer_train_only_win_lose_filtered.groupby(['beer/name', 'status']).agg(\n",
        "    mean_avg_review=('avg_review', 'mean'),\n",
        "    std_avg_review=('avg_review', 'std'),\n",
        "    count=('avg_review', 'count')\n",
        ").reset_index()\n",
        "\n",
        "# Доверительные интервалы\n",
        "summary_stats['conf_interval'] = 1.96 * (summary_stats['std_avg_review'] / np.sqrt(summary_stats['count']))\n",
        "\n",
        "# Построение диаграммы + окрашиваем лучшие и худшие марки в зеленый и красный для наглядности\n",
        "fig, ax = plt.subplots(figsize=(7, 7))\n",
        "colors = summary_stats['status'].map({'winner': 'green', 'loser': 'red'})\n",
        "\n",
        "# Столбцы для средних значений\n",
        "bars = ax.bar(summary_stats['beer/name'], summary_stats['mean_avg_review'], yerr=summary_stats['conf_interval'],\n",
        "               color=colors, capsize=5)\n",
        "\n",
        "# Настройка параметров\n",
        "ax.set_title('Средние оценки для лучших и худших марок пива')\n",
        "ax.set_xlabel('Марка')\n",
        "ax.set_ylabel('Средняя оценка')\n",
        "ax.set_xticklabels(summary_stats['beer/name'], rotation=90)\n",
        "ax.grid(axis='y')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n"
      ],
