    {
      "cell_type": "code",
      "source": [
        "import category_encoders as ce\n",
        "from sklearn.feature_selection import SelectKBest, f_regression\n",
        "\n",
        "# Определим целевую переменную и признаки\n",
        "X_train = beer_train.drop('avg_review', axis=1) #удяляем avg_reveiw, так как это будет целевая переменная\n",
        "y_train = beer_train['avg_review']\n",
        "X_test = beer_test.drop('avg_review', axis=1) #присваиваем переменной тестовый датасет\n",
        "\n",
        "# Создадим one-hot признаки, используя category_encoders\n",
        "categorical_features = ['beer/brewerId', 'beer/name', 'beer/style', 'user/gender', 'user/profileName']\n",
        "\n",
        "encoder = ce.OneHotEncoder(cols=categorical_features, use_cat_names=True) #создаем экземпляр класса и указываем нужные столбцы\n",
        "X_train_encoded = encoder.fit_transform(X_train) #применяем кодировщик для тренировочного набора\n",
        "X_test_encoded = encoder.transform(X_test) #применяем уже обученный кодировщик для тестового набора\n",
        "\n",
        "# Отберем лучшие признаки\n",
        "selector = SelectKBest(score_func=f_regression, k=10)  #выбираем 10 лучших признаков\n",
        "X_train_selected = selector.fit_transform(X_train_encoded, y_train) #применяем селектор\n",
        "selected_indices = selector.get_support(indices=True)\n",
        "selected_feature_names = X_train_encoded.columns[selected_indices]\n",
        "\n",
        "# Создадим новые датафреймы\n",
        "X_train_final = X_train_encoded[selected_feature_names]\n",
