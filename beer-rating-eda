        "# Реализуем функцию для обработки аномалий с использованием метода Z-оценки\n",
        "def handle_anomalies(df, column):\n",
        "    mean = df[column].mean()\n",
        "    std_dev = df[column].std()\n",
        "    z_scores = (df[column] - mean) / std_dev\n",
        "    # Можно заменить аномальные значения на границы (верхнюю и нижнюю)\n",
        "    df[column] = np.where(z_scores > 3, mean + 3 * std_dev, df[column])\n",
        "    df[column] = np.where(z_scores < -3, mean - 3 * std_dev, df[column])\n",
        "\n",
        "# Обработаем аномалии для градусов и для возраста с помощью функции\n",
        "handle_anomalies(beer_train, 'beer/ABV')\n",
